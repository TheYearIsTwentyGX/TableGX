registry=https://registry.npmjs.org/

; Scope -> registry routing. Same package name ("tablegx"), different scope per registry.
@twentygx:registry=https://registry.npmjs.org/
@tutera:registry=http://52.165.90.230:4873/

; Auth via secrets (env interpolation). Never commit raw tokens.
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
//52.165.90.230:4873/:_auth=${TUTERA_AUTH}
