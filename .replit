modules = ["web", "nodejs-22", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Playground"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "skills"

[[workflows.workflow]]
name = "Playground"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:playground"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "skills"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:skills:strict"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 63315
externalPort = 3000
exposeLocalhost = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
